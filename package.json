{
  "name": "levegominoseg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*' && bun run copy:public",
    "copy:public": "cp -R public/. dist/",
    "start": "NODE_ENV=production bun src/index.ts",
    "lint": "oxlint",
    "test": "bun test --concurrency 1",
    "test:watch": "bun test --watch --concurrency 1",
    "deploy": "bun run build && npx wrangler pages deploy dist --project-name=levegominoseg --commit-dirty=true"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.75.0",
    "typescript": "^7"
  }
}
